{
  "version": 2,
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/app-debug.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"ProductivityAI.apk\""
      },
      "dest": "/app-debug.apk"
    },
    { "src": "/ppt", "dest": "/ppt.html" },
    { "src": "/presentation", "dest": "/ppt.html" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/simulator", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
