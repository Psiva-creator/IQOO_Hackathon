{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InsightOutput",
  "description": "Insight data structure output by insight-engine and rendered by app-ui and data-sync",
  "type": "object",
  "properties": {
    "peakHour": {
      "type": "string",
      "description": "Human readable time window of peak focus (e.g. '09:00 - 11:00 AM')"
    },
    "procrastinationTrigger": {
      "type": "string",
      "description": "Detected pattern or context where tasks stall or fail (e.g. 'Writing tasks scheduled after 3:00 PM')"
    },
    "bestContext": {
      "type": "string",
      "description": "Optimal environment/conditions for productivity"
    },
    "recommendation": {
      "type": "string",
      "description": "Actionable coaching advice for the user"
    },
    "productivityScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall habit health index (0-100)"
    },
    "confidenceLevel": {
      "type": "string",
      "enum": ["Calibrating", "Medium", "High"]
    },
    "hourlyHeatmap": {
      "type": "object",
      "description": "Productivity focus scores (0-100) indexed by hour of day (0-23)",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "fatigueLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Calculated cognitive and session fatigue level"
    },
    "fatigueScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Quantified fatigue score (0-100)"
    },
    "explanation": {
      "type": "string",
      "description": "Explainable summary of detected fatigue and context factors"
    },
    "contextInsights": {
      "type": "array",
      "description": "Performance metrics across environments/contexts",
      "items": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string"
          },
          "completionRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "totalTasks": {
            "type": "integer"
          },
          "completedTasks": {
            "type": "integer"
          },
          "avgDuration": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["Optimal", "Moderate", "Suboptimal"]
          }
        },
        "required": ["context", "completionRate", "totalTasks", "completedTasks", "status"]
      }
    },
    "distractionSensitivity": {
      "type": "object",
      "description": "Sensitivity metrics correlating non-productive contexts with task failure",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vulnerableCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggerAppCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["level", "score", "summary"]
    },
    "productivityProfile": {
      "type": "object",
      "description": "Personal productivity profile summarizing temporal, context, and habit strengths",
      "properties": {
        "bestFocusWindow": {
          "type": "string"
        },
        "bestTaskTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bestContext": {
          "type": "string"
        },
        "weakestFocusWindow": {
          "type": "string"
        },
        "peakProductivityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "averageCompletionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fatiguePattern": {
          "type": "string"
        },
        "distractionPattern": {
          "type": "string"
        },
        "profileConfidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "taskTypeAnalysis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskType": {
                "type": "string"
              },
              "strongestWindow": {
                "type": "string"
              },
              "completionRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "abandonmentRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "avgDuration": {
                "type": "number"
              },
              "productivityScore": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "totalSessions": {
                "type": "integer"
              }
            },
            "required": ["taskType", "strongestWindow", "completionRate", "abandonmentRate", "avgDuration", "productivityScore", "totalSessions"]
          }
        }
      },
      "required": [
        "bestFocusWindow",
        "bestTaskTypes",
        "bestContext",
        "weakestFocusWindow",
        "peakProductivityScore",
        "averageCompletionRate",
        "fatiguePattern",
        "distractionPattern",
        "profileConfidence"
      ]
    },
    "adaptiveRecommendations": {
      "type": "array",
      "description": "Ranked adaptive coaching recommendations derived from calculated profile metrics",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "advice": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "impact": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          }
        },
        "required": ["title", "advice", "reason", "priority", "impact"]
      }
    },
    "taskPrediction": {
      "type": "object",
      "description": "Predictive productivity assessment for starting a specific task at the current moment ('Should I do this task now?')",
      "properties": {
        "taskType": {
          "type": "string"
        },
        "predictedScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "riskLevel": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "bestAlternativeWindow": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        }
      },
      "required": ["predictedScore", "confidence", "riskLevel", "bestAlternativeWindow", "reason", "recommendation"]
    },
    "predictionCalibration": {
      "type": "object",
      "description": "Continuous calibration tracking prediction accuracy versus real user task outcomes",
      "properties": {
        "totalEvaluations": {
          "type": "integer",
          "minimum": 0
        },
        "accuratePredictions": {
          "type": "integer",
          "minimum": 0
        },
        "accuracyRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "meanCalibrationError": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lastPredictionOutcome": {
          "type": "string",
          "enum": ["ACCURATE", "INACCURATE", "NONE"]
        },
        "lastPredictedScore": {
          "type": ["integer", "null"]
        },
        "lastActualOutcome": {
          "type": "string",
          "enum": ["COMPLETED", "ABANDONED", "NONE"]
        }
      },
      "required": ["totalEvaluations", "accuratePredictions", "accuracyRate", "meanCalibrationError", "lastPredictionOutcome"]
    }
  },
  "required": ["peakHour", "procrastinationTrigger", "bestContext", "recommendation"]
}
