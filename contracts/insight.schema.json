{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InsightOutput",
  "description": "Insight data structure output by insight-engine and rendered by app-ui and data-sync",
  "type": "object",
  "properties": {
    "peakHour": {
      "type": "string",
      "description": "Human readable time window of peak focus (e.g. '09:00 - 11:00 AM')"
    },
    "procrastinationTrigger": {
      "type": "string",
      "description": "Detected pattern or context where tasks stall or fail (e.g. 'Writing tasks scheduled after 3:00 PM')"
    },
    "bestContext": {
      "type": "string",
      "description": "Optimal environment/conditions for productivity"
    },
    "recommendation": {
      "type": "string",
      "description": "Actionable coaching advice for the user"
    },
    "productivityScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall habit health index (0-100)"
    },
    "confidenceLevel": {
      "type": "string",
      "enum": ["Calibrating", "Medium", "High"]
    },
    "hourlyHeatmap": {
      "type": "object",
      "description": "Productivity focus scores (0-100) indexed by hour of day (0-23)",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "fatigueLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Calculated cognitive and session fatigue level"
    },
    "fatigueScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Quantified fatigue score (0-100)"
    },
    "explanation": {
      "type": "string",
      "description": "Explainable summary of detected fatigue and context factors"
    },
    "contextInsights": {
      "type": "array",
      "description": "Performance metrics across environments/contexts",
      "items": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string"
          },
          "completionRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "totalTasks": {
            "type": "integer"
          },
          "completedTasks": {
            "type": "integer"
          },
          "avgDuration": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["Optimal", "Moderate", "Suboptimal"]
          }
        },
        "required": ["context", "completionRate", "totalTasks", "completedTasks", "status"]
      }
    },
    "distractionSensitivity": {
      "type": "object",
      "description": "Sensitivity metrics correlating non-productive contexts with task failure",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vulnerableCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggerAppCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["level", "score", "summary"]
    }
  },
  "required": ["peakHour", "procrastinationTrigger", "bestContext", "recommendation"]
}
